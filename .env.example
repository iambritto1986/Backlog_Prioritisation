# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Postgres connection string for Prisma.
# Get this from Render dashboard -> your Postgres instance -> "Internal Database URL"
# (internal, since Express and Postgres live on the same Render private network —
# never expose the database on a public URL).
# Server-side only. Never reference this anywhere under src/.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Clerk ---
# This is a Vite app, not Next.js — env var names matter here and are NOT the
# same as Clerk's Next.js quickstart snippets (no NEXT_PUBLIC_ prefix).

# VITE_CLERK_PUBLISHABLE_KEY: read by the Vite build at BUILD TIME and inlined
# into the browser bundle. Client-safe — this is meant to be public.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."

# CLERK_PUBLISHABLE_KEY: the same value as above, also needed server-side —
# @clerk/express reads this (and CLERK_SECRET_KEY) from process.env at runtime.
CLERK_PUBLISHABLE_KEY="pk_test_..."

# CLERK_SECRET_KEY: server-side only. Never reference this anywhere under src/.
CLERK_SECRET_KEY="sk_test_..."
